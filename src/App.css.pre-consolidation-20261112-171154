:root {
  --bg: #090909;
  --sidebar: #0c0b09;
  --panel: #15130f;
  --panel2: #1c1811;
  --line: #44351f;
  --muted: #a69a83;
  --text: #f4eee1;
  --blue: #c4a66a;
  --cyan: #ead29a;
  --gold: #c4a66a;
  --gold-light: #f2dfad;
  --gold-dark: #80602e;
}

.app-shell {
  background:
    radial-gradient(ellipse at 78% 0%, #6d4c1b18 0%, transparent 36%),
    radial-gradient(ellipse at 10% 70%, #9b702012 0%, transparent 40%),
    #090909;
}

.sidebar {
  background:
    linear-gradient(180deg, #15110b 0%, #0b0a08 55%, #100d09 100%);
  border-right: 1px solid #594323;
  box-shadow: 8px 0 35px #0008;
}

.brand {
  color: var(--gold-light);
  font-size: 23px;
  letter-spacing: 4px;
  text-shadow: 0 0 22px #c4a66a44;
}

.brand-symbol {
  border: 1px solid #e0c17e;
  border-radius: 8px;
  background: linear-gradient(145deg, #f0d99d, #9d773a 48%, #5c401b);
  color: #171008;
  box-shadow: 0 0 22px #c4a66a55, inset 0 1px 2px #fff8;
}

.brand-dot,.heading-dot { color: #d7b879; }

.workspace {
  border-color: #574328;
  background: linear-gradient(120deg, #292013, #17120b);
  box-shadow: inset 0 1px #ffffff08, 0 8px 20px #0004;
}

.workspace-avatar,.profile-avatar {
  background: linear-gradient(145deg, #e4c987, #967039 55%, #5a3c18);
  color: #1b1308;
  box-shadow: 0 0 14px #c4a66a35;
}

.workspace strong,.profile strong { color: #f2e3c2; }
.workspace span,.profile-info span { color: #a18d69; }
.workspace > svg { color: #c4a66a; }

.nav-caption {
  color: #9c8252;
  letter-spacing: 2px;
}

.nav-item {
  min-height: 43px;
  border: 1px solid transparent;
  border-radius: 7px;
  color: #b6aa95;
}

.nav-item:hover {
  border-color: #594323;
  background: linear-gradient(90deg, #3a2a14, #1c160e);
  color: #f8e9c8;
}

.nav-item.active {
  color: #f3d99f;
  border-color: #80602e;
  background: linear-gradient(100deg, #59401e66, #251b0e);
  box-shadow: inset 3px 0 #e4c17b, 0 0 20px #c4a66a12;
}

.nav-item.active svg { color: #e6c47e; }

.nav-dot {
  background: #e2bd72;
  box-shadow: 0 0 10px #e2bd72;
}

.ai-card {
  border-color: #846533;
  border-radius: 8px;
  background:
    radial-gradient(circle at 100% 0%, #c4a66a25, transparent 60%),
    linear-gradient(145deg, #302313, #171109);
  box-shadow: inset 0 1px #fff2, 0 10px 28px #0005;
}

.ai-icon {
  color: #f2d99e;
  border: 1px solid #9d793f;
  border-radius: 7px;
  background: linear-gradient(145deg, #705326, #34230e);
}

.ai-card p { color: #b8a582; }
.coming-soon { color: #e5c681; }
.profile { border-top-color: #594323; }
.profile > svg { color: #c4a66a; }

.topbar {
  border-bottom-color: #49371f;
  background: #0c0a08ed;
  box-shadow: 0 5px 25px #0005;
}

.breadcrumb { color: #9c8c70; }
.breadcrumb strong { color: #f0dfbd; }

.search-box {
  border-color: #594323;
  border-radius: 6px;
  background: #18130d;
  color: #c4a66a;
}

.search-box:focus-within {
  border-color: #d1ae68;
  box-shadow: 0 0 0 3px #c4a66a1c;
}

.search-box input { color: #f6ead2; }
.search-box kbd { color: #a38b5e; }

.icon-button {
  border-color: #624b2a;
  border-radius: 7px;
  background: linear-gradient(145deg, #211a10, #100d09);
  color: #dfc184;
}

.icon-button:hover {
  border-color: #e0bd75;
  color: #fff0c9;
  box-shadow: 0 0 18px #c4a66a30;
}

.icon-button i {
  background: #e7c478;
  box-shadow: 0 0 9px #e7c478;
}

.top-avatar {
  border-color: #d6b46e;
  background: linear-gradient(145deg, #e5c987, #805b27);
  color: #1a1207;
  box-shadow: 0 0 16px #c4a66a35;
}

.dashboard {
  position: relative;
}

.dashboard::before {
  content: '';
  position: fixed;
  pointer-events: none;
  inset: 70px 0 0 250px;
  opacity: .11;
  background-image:
    linear-gradient(45deg, #c4a66a 1px, transparent 1px),
    linear-gradient(-45deg, #c4a66a 1px, transparent 1px);
  background-size: 70px 70px;
  mask-image: linear-gradient(to bottom, #000, transparent 65%);
}

.eyebrow,.section-kicker {
  color: #d5b36d;
  letter-spacing: 2px;
}

.status-dot,.live-label span {
  background: #d7b96f;
  box-shadow: 0 0 12px #d7b96f99;
}

.welcome-section h1 {
  color: #f5e8cd;
  font-family: 'Cormorant Garamond', serif;
  font-size: 43px;
  font-weight: 700;
  letter-spacing: -.5px;
  text-shadow: 0 3px 25px #c4a66a20;
}

.welcome-subtitle { color: #b9aa8e; }
.date-label { color: #a28c64; }

.primary-button {
  border: 1px solid #e8cb8b;
  border-radius: 5px;
  background: linear-gradient(115deg, #f0d99e 0%, #c4a66a 42%, #87602e 100%);
  color: #1b1308;
  font-weight: 800;
  box-shadow: 0 7px 25px #c4a66a38, inset 0 1px #fff9;
  text-transform: uppercase;
  letter-spacing: .4px;
}

.primary-button:hover {
  filter: brightness(1.16);
  box-shadow: 0 8px 32px #c4a66a65;
}

.hero-grid { gap: 19px; }

.hero-card,.together-card {
  border: 1px solid #846333;
