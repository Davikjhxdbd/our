    0 5px 18px rgba(0,0,0,0.15);
}

/* Tarefas com superfície de vidro */
.task-row {
  background: rgba(255,255,255,0.035);
  border: 1px solid rgba(255,255,255,0.10);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  border-radius: 12px;
}

/* Transições suaves */
.hero-card,
.together-card,
.stat-card,
.panel,
.module-card,
.nav-item,
.search-box,
.icon-button {
  transition:
    background 260ms ease,
    border-color 260ms ease,
    box-shadow 260ms ease,
    transform 260ms ease;
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
  }
}

/* OUR — LIQUID GLASS: FINAL POLISH */

/* Mais transparência nas superfícies */
.sidebar,
.sidebar-wrap {
  background: rgba(12, 11, 10, 0.44) !important;
  backdrop-filter: blur(42px) saturate(200%);
  -webkit-backdrop-filter: blur(42px) saturate(200%);
}

.topbar {
  background: rgba(15, 14, 12, 0.32) !important;
  backdrop-filter: blur(38px) saturate(200%);
  -webkit-backdrop-filter: blur(38px) saturate(200%);
}

.hero-card,
.together-card,
.stat-card,
.panel,
.module-card,
.ai-card {
  background:
    radial-gradient(ellipse at 12% 0%, rgba(255,255,255,0.105), transparent 42%),
    radial-gradient(ellipse at 90% 100%, rgba(196,166,106,0.075), transparent 45%),
    rgba(22, 21, 19, 0.30) !important;
  backdrop-filter: blur(38px) saturate(200%);
  -webkit-backdrop-filter: blur(38px) saturate(200%);
  border: 1px solid rgba(255,255,255,0.19);
}

/* Reflexo de luz na borda superior */
.hero-card::after,
.together-card::after,
.stat-card::after,
.panel::after,
.module-card::after,
.ai-card::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
  background: linear-gradient(
    115deg,
    rgba(255,255,255,0.13),
    transparent 18%,
    transparent 78%,
    rgba(196,166,106,0.08)
  );
  opacity: 0.55;
  mask-image: linear-gradient(to bottom, black, transparent 48%);
  -webkit-mask-image: linear-gradient(to bottom, black, transparent 48%);
}

/* Controles com acabamento de lente */
.search-box,
.icon-button,
.mobile-menu {
  background: linear-gradient(
    145deg,
    rgba(255,255,255,0.11),
    rgba(255,255,255,0.025)
  ) !important;
  border: 1px solid rgba(255,255,255,0.20);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.22),
    inset 0 -1px 0 rgba(255,255,255,0.035),
    0 8px 24px rgba(0,0,0,0.20);
}

/* Realce dourado discreto nos elementos ativos */
.nav-item.active {
  background: linear-gradient(
    120deg,
    rgba(196,166,106,0.23),
    rgba(255,255,255,0.055)
  ) !important;
  border-color: rgba(225,198,145,0.34);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.20),
    0 0 22px rgba(196,166,106,0.07);
}

/* Superfície interna das tarefas */
.task-row {
  background: rgba(255,255,255,0.045);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

/* Evita excesso de movimento em dispositivos móveis */
@media (hover: none) {
  .hero-card,
  .together-card,
  .stat-card,
  .panel,
  .module-card {
    transform: none !important;
  }
}

/* OUR — FLOATING GLASS CONTROLS */

/* Botões secundários */
.text-button,
.panel-footer,
.hero-content button,
.together-card > button {
  background: linear-gradient(
    145deg,
    rgba(255,255,255,0.085),
    rgba(255,255,255,0.025)
  );
  border: 1px solid rgba(255,255,255,0.13);
  border-radius: 12px;
  padding: 9px 13px;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.12);
  transition: all 220ms ease;
}

.text-button:hover,
.panel-footer:hover,
.hero-content button:hover,
.together-card > button:hover {
  background: rgba(196,166,106,0.14);
  border-color: rgba(196,166,106,0.34);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.17),
    0 5px 20px rgba(196,166,106,0.08);
}

/* Avatares com acabamento de vidro */
.top-avatar,
.profile-avatar,
.workspace-avatar,
.couple-avatars > * {
  border: 1px solid rgba(255,230,180,0.40);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.42),
    0 5px 18px rgba(0,0,0,0.25);
}

/* Ícones e pequenos indicadores */
.module-icon,
.empty-icon,
.together-icon,
.ai-icon {
  background: linear-gradient(
    145deg,
    rgba(196,166,106,0.24),
    rgba(196,166,106,0.07)
  );
  border: 1px solid rgba(220,190,130,0.28);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.20),
    0 5px 18px rgba(0,0,0,0.20);
}

/* Busca mais integrada ao sistema */
.search-box:focus-within {
  background: rgba(196,166,106,0.10) !important;
  border-color: rgba(225,198,145,0.48);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.17),
    0 0 0 3px rgba(196,166,106,0.07),
    0 8px 25px rgba(0,0,0,0.20);
}

/* Feedback de clique */
button:active {
  transform: scale(0.98);
}

/* Rolagem discreta */
* {
  scrollbar-width: thin;
  scrollbar-color: rgba(196,166,106,0.30) transparent;
}

*::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background: rgba(196,166,106,0.25);
  border-radius: 20px;
}

*::-webkit-scrollbar-thumb:hover {
  background: rgba(196,166,106,0.48);
}
