/* Avatares e ícones */
.top-avatar,
.profile-avatar,
.workspace-avatar,
.couple-avatars > *,
.module-icon,
.empty-icon,
.together-icon {
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.16),
    0 5px 18px rgba(0,0,0,0.20);
}

/* Divisórias mais delicadas */
.sidebar,
.topbar,
.panel-header {
  border-color: rgba(255,255,255,0.085);
}

/* Seleção e foco */
button:focus-visible,
input:focus-visible {
  outline: 2px solid rgba(196,166,106,0.72);
  outline-offset: 3px;
}

/* Suporte e acessibilidade */
@supports not (backdrop-filter: blur(10px)) {
  .sidebar,
  .sidebar-wrap,
  .topbar,
  .search-box,
  .hero-card,
  .together-card,
  .stat-card,
  .panel,
  .module-card,
  .ai-card {
    background-color: #191611;
  }
}

@media (prefers-reduced-motion: reduce) {
  .hero-card,
  .together-card,
  .stat-card,
  .panel,
  .module-card,
  .nav-item,
  .primary-button {
    transition: none !important;
  }
