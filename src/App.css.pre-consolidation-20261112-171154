/* OUR — LIQUID GLASS */

:root {
  --glass-bg: rgba(255, 255, 255, 0.035);
  --glass-border: rgba(255, 255, 255, 0.10);
  --glass-gold: rgba(196, 166, 106, 0.16);
  --glass-blur: blur(22px) saturate(145%);
}

/* Painéis e cards */
.stat-card,
.together-card,
.module-card {
  background:
    linear-gradient(135deg, rgba(255,255,255,0.075), transparent 55%),
    linear-gradient(145deg, rgba(196,166,106,0.055), transparent 65%),
    rgba(20, 18, 14, 0.72);
  backdrop-filter: var(--glass-blur);
  -webkit-backdrop-filter: var(--glass-blur);
  border: 1px solid var(--glass-border);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.10),
    inset 0 -1px 0 rgba(196,166,106,0.07),
    0 12px 35px rgba(0,0,0,0.24);
}

/* Brilho sutil ao passar o mouse */
.stat-card:hover,
.together-card:hover,
.module-card:hover {
  border-color: rgba(196,166,106,0.38);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.14),
    0 16px 42px rgba(0,0,0,0.34),
    0 0 24px rgba(196,166,106,0.07);
  transform: translateY(-2px);
  transition: all 220ms ease;
}

/* Botões */
.primary-button {
  background: linear-gradient(
    135deg,
    #e0c58c 0%,
    #b99758 48%,
    #8e6b36 100%
  );
  border: 1px solid rgba(255,235,190,0.45);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.35),
    0 5px 20px rgba(196,166,106,0.16);
}

/* Elementos de navegação */
.nav-item {
  transition: background 180ms ease, border-color 180ms ease;
}

.nav-item:hover {
  background: rgba(255,255,255,0.055);
  border-color: rgba(196,166,106,0.18);
}

/* Reflexo de vidro nos cards */
.stat-card,
.together-card,
.module-card {
  position: relative;
  overflow: hidden;
}

.stat-card::before,
.together-card::before,
.module-card::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(
    115deg,
    rgba(255,255,255,0.075),
    transparent 28%,
    transparent 72%,
    rgba(196,166,106,0.045)
  );
  opacity: 0.8;
}

/* Respeita dispositivos sem suporte a blur */
@supports not (backdrop-filter: blur(10px)) {
  .stat-card,
  .together-card,
  .module-card {
    background: #191611;
  }
}

/* =========================================
   OUR — APPLE LIQUID GLASS EXPERIENCE
   Black / Gold Edition
========================================= */

:root {
  --liquid-black: rgba(15, 14, 12, 0.76);
  --liquid-dark: rgba(25, 23, 19, 0.72);
  --liquid-border: rgba(255, 255, 255, 0.13);
  --liquid-highlight: rgba(255, 255, 255, 0.10);
  --liquid-gold: rgba(196, 166, 106, 0.22);
  --liquid-blur: blur(28px) saturate(180%);
}

/* Fundo com profundidade */
body {
  background:
    radial-gradient(ellipse at 12% 8%, rgba(196,166,106,0.09), transparent 35%),
    radial-gradient(ellipse at 88% 75%, rgba(160,125,65,0.055), transparent 38%),
    #090909;
}

/* Sidebar de vidro */
.sidebar,
.sidebar-wrap {
  background: rgba(13, 12, 10, 0.78) !important;
  backdrop-filter: var(--liquid-blur);
  -webkit-backdrop-filter: var(--liquid-blur);
  border-right: 1px solid var(--liquid-border);
  box-shadow:
    inset -1px 0 0 rgba(255,255,255,0.035),
    12px 0 40px rgba(0,0,0,0.20);
}

/* Barra superior flutuante */
.topbar {
  background: rgba(13, 12, 10, 0.62);
  backdrop-filter: var(--liquid-blur);
  -webkit-backdrop-filter: var(--liquid-blur);
  border-bottom: 1px solid rgba(255,255,255,0.09);
  box-shadow: 0 8px 30px rgba(0,0,0,0.12);
}

/* Busca */
.search-box {
  background: rgba(255,255,255,0.045);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.08),
    0 4px 16px rgba(0,0,0,0.12);
  transition: all 220ms ease;
}

.search-box:focus-within {
  border-color: rgba(196,166,106,0.48);
  background: rgba(196,166,106,0.075);
  box-shadow: 0 0 24px rgba(196,166,106,0.09);
}

/* Cards e painéis */
.hero-card,
.together-card,
.stat-card,
.panel,
.module-card,
.ai-card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(255,255,255,0.075), transparent 42%),
    linear-gradient(315deg, rgba(196,166,106,0.055), transparent 60%),
    rgba(24,22,18,0.68);
  backdrop-filter: var(--liquid-blur);
  -webkit-backdrop-filter: var(--liquid-blur);
  border: 1px solid var(--liquid-border);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.13),
    inset 0 -1px 0 rgba(196,166,106,0.07),
    0 15px 45px rgba(0,0,0,0.24);
}

/* Reflexo superior de lente */
.hero-card::before,
.together-card::before,
.stat-card::before,
.panel::before,
.module-card::before,
.ai-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  background:
    linear-gradient(
      125deg,
      rgba(255,255,255,0.13) 0%,
      rgba(255,255,255,0.025) 18%,
      transparent 42%,
      transparent 78%,
      rgba(196,166,106,0.055) 100%
    );
  opacity: 0.8;
}

/* Reflexos e movimento */
.hero-card,
.together-card,
.stat-card,
.panel,
.module-card {
  transition:
    transform 260ms cubic-bezier(.2,.8,.2,1),
    border-color 260ms ease,
    box-shadow 260ms ease,
    background 260ms ease;
}

.together-card:hover,
.stat-card:hover,
.module-card:hover {
  transform: translateY(-3px);
  border-color: rgba(220,190,130,0.38);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.18),
    0 20px 48px rgba(0,0,0,0.34),
    0 0 28px rgba(196,166,106,0.075);
}

/* Navegação com vidro */
.nav-item {
  border: 1px solid transparent;
  transition: all 200ms ease;
}

.nav-item:hover {
  background: rgba(255,255,255,0.065);
  border-color: rgba(255,255,255,0.09);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
}

.nav-item.active {
  background:
    linear-gradient(110deg, rgba(196,166,106,0.19), rgba(196,166,106,0.055));
  border: 1px solid rgba(196,166,106,0.24);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.10),
    0 4px 18px rgba(0,0,0,0.15);
}

/* Linhas de tarefas */
.task-row {
  background: rgba(255,255,255,0.025);
  border: 1px solid rgba(255,255,255,0.065);
  border-radius: 12px;
  transition: all 200ms ease;
}

.task-row:hover {
  background: rgba(255,255,255,0.065);
  border-color: rgba(196,166,106,0.22);
}

/* Botões de vidro */
.icon-button,
.mobile-menu,
.mobile-close {
  background: rgba(255,255,255,0.055);
  border: 1px solid rgba(255,255,255,0.12);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.10);
  transition: all 200ms ease;
}

.icon-button:hover,
.mobile-menu:hover,
.mobile-close:hover {
  background: rgba(196,166,106,0.14);
  border-color: rgba(196,166,106,0.35);
}

/* Botão principal com acabamento metálico */
.primary-button {
  background:
    linear-gradient(135deg, #e5cb96 0%, #c4a66a 48%, #92703b 100%);
  border: 1px solid rgba(255,238,195,0.55);
  color: #17120a;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.48),
    inset 0 -1px 0 rgba(80,55,20,0.25),
    0 8px 24px rgba(196,166,106,0.20);
  transition: all 220ms ease;
}

.primary-button:hover {
  filter: brightness(1.09);
  transform: translateY(-2px);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.58),
