:root {
  --bg: #0b0d13;
  --sidebar: #0e1017;
  --panel: #12151e;
  --panel2: #151925;
  --line: #252938;
  --muted: #858b9e;
  --text: #eef0f8;
  --blue: #7774ed;
  --cyan: #7b9cff;
}

#root { min-height: 100vh; }
.app-shell { min-height: 100vh; background: var(--bg); }
.sidebar-wrap { position: fixed; inset: 0 auto 0 0; width: 250px; z-index: 20; }
.sidebar { height: 100%; display: flex; flex-direction: column; padding: 25px 17px 15px; background: var(--sidebar); border-right: 1px solid #202331; }
.brand { height: 39px; display: flex; align-items: center; gap: 10px; padding: 0 8px; color: white; font-family: Manrope,sans-serif; font-weight: 800; font-size: 20px; letter-spacing: 2px; }
.brand-symbol { width: 28px; height: 28px; display: grid; place-items: center; border-radius: 9px; background: linear-gradient(145deg,#8985ff,#5654bd); color: white; font-size: 17px; }
.brand-dot,.heading-dot { color: #8581ff; }
.workspace { display: flex; align-items: center; gap: 10px; margin: 31px 0 29px; padding: 12px 10px; border: 1px solid #252938; background: #141722; border-radius: 10px; }
.workspace-avatar,.profile-avatar { display: grid; place-items: center; flex-shrink: 0; width: 31px; height: 31px; border-radius: 9px; color: white; background: linear-gradient(145deg,#7672e9,#45458c); font-weight: 700; }
.workspace div:nth-child(2),.profile-info { display: flex; flex: 1; flex-direction: column; gap: 3px; }
.workspace strong,.profile strong { font-size: 11px; color: #e8eaf2; font-weight: 600; }
.workspace span,.profile-info span { font-size: 10px; color: #777e91; }
.workspace > svg { color: #777e91; }
.nav-caption { display: block; padding: 0 10px; margin-bottom: 10px; color: #646b7f; font-size: 9px; font-weight: 700; letter-spacing: 1.4px; }
.navigation { display: grid; gap: 4px; }
.nav-item { display: flex; align-items: center; gap: 12px; width: 100%; min-height: 40px; padding: 0 11px; border: 0; border-radius: 8px; background: transparent; color: #9298aa; text-align: left; font-size: 12px; transition: .2s; }
.nav-item:hover { background: #191d2a; color: white; }
.nav-item.active { color: #aaa7ff; background: #7774ed19; box-shadow: inset 2px 0 #817dff; }
.nav-item.active svg { color: #9692ff; }
.nav-dot { margin-left: auto; width: 6px; height: 6px; border-radius: 50%; background: #7774ed; }
.modules-caption { margin-top: 30px; }
.sidebar-bottom { margin-top: auto; }
.ai-card { position: relative; margin: 0 1px 17px; padding: 14px; border: 1px solid #34304e; border-radius: 11px; background: linear-gradient(140deg,#1a1b30,#151624 75%); }
.ai-icon { display: grid; place-items: center; width: 28px; height: 28px; margin-bottom: 10px; color: #a39fff; border-radius: 8px; background: #7774ed22; }
.ai-card strong { font-size: 11px; }
.ai-card p { margin: 6px 0 10px; color: #898da3; font-size: 10px; line-height: 1.5; }
.coming-soon { color: #aaa5ff; font-size: 8px; font-weight: 700; letter-spacing: 1px; }
.settings-item { margin-bottom: 10px; }
.profile { display: flex; align-items: center; gap: 10px; padding: 13px 4px 2px; border-top: 1px solid #252938; }
.profile-avatar { width: 33px; height: 33px; border-radius: 50%; }
.profile > svg { color: #777e91; }
.mobile-close,.mobile-menu,.mobile-overlay { display: none; }

.main-area { min-height: 100vh; margin-left: 250px; }
.topbar { position: sticky; top: 0; z-index: 10; height: 70px; display: flex; align-items: center; justify-content: space-between; padding: 0 43px; border-bottom: 1px solid #202331; background: #0b0d13ed; backdrop-filter: blur(15px); }
.breadcrumb,.topbar-actions { display: flex; align-items: center; gap: 12px; }
.breadcrumb { color: #737a8e; font-size: 11px; }
.breadcrumb strong { color: #e3e5ef; font-weight: 500; }
.topbar-actions { gap: 18px; }
.search-box { display: flex; align-items: center; gap: 9px; width: 220px; padding: 8px 10px; border: 1px solid #252938; border-radius: 8px; color: #788094; }
.search-box input { width: 100%; min-width: 0; outline: none; border: 0; background: transparent; color: white; font-size: 11px; }
.search-box kbd { white-space: nowrap; color: #6e7486; font-size: 9px; }
.icon-button { position: relative; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid #252938; border-radius: 9px; background: transparent; color: #a2a8b8; }
.icon-button i { position: absolute; top: 7px; right: 7px; width: 5px; height: 5px; border-radius: 50%; background: #8581ff; }
.top-avatar { display: grid; place-items: center; width: 31px; height: 31px; border: 1px solid #7774ed66; border-radius: 50%; background: #28264b; color: #c1bfff; font-size: 11px; font-weight: 700; }

.dashboard { max-width: 1440px; margin: 0 auto; padding: 37px 43px 22px; }
.welcome-section { display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 27px; }
.eyebrow,.section-kicker { display: flex; align-items: center; gap: 8px; color: #8581ef; font-size: 9px; font-weight: 700; letter-spacing: 1.4px; }
.status-dot,.live-label span { width: 6px; height: 6px; border-radius: 50%; background: #7bdaaf; box-shadow: 0 0 10px #7bdaaf88; }
h1,h2,h3,p { margin-top: 0; }
.welcome-section h1 { margin: 11px 0 5px; color: #f1f2fa; font: 700 31px/1.2 Manrope,sans-serif; letter-spacing: -1.2px; }
.welcome-subtitle { margin: 0 0 10px; color: #9298a9; font-size: 12px; }
.date-label { color: #666e82; font-size: 10px; text-transform: capitalize; }
.primary-button { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border: 0; border-radius: 8px; background: linear-gradient(110deg,#7774ed,#625fd0); color: white; font-size: 11px; font-weight: 600; box-shadow: 0 5px 20px #7774ed28; }
.primary-button:hover { filter: brightness(1.12); }

.hero-grid { display: grid; grid-template-columns: 1.55fr 1fr; gap: 17px; }
.hero-card,.together-card { position: relative; min-height: 245px; overflow: hidden; border: 1px solid #2a2e43; border-radius: 13px; }
.hero-card { background: linear-gradient(115deg,#171b2b 0%,#17182b 54%,#222047 100%); }
.hero-glow { position: absolute; width: 380px; height: 300px; top: -170px; right: 0; border-radius: 50%; background: #7774ed25; filter: blur(60px); }
.hero-content { position: relative; z-index: 2; padding: 25px 27px; }
.hero-tag { display: inline-flex; align-items: center; gap: 7px; color: #a7a3ff; font-size: 8px; font-weight: 700; letter-spacing: 1.1px; }
.hero-content h2 { margin: 19px 0 9px; color: #f4f3ff; font: 700 24px/1.35 Manrope,sans-serif; letter-spacing: -.7px; }
.hero-content p { max-width: 290px; margin-bottom: 17px; color: #a2a5ba; font-size: 10px; line-height: 1.6; }
.hero-content button,.together-card > button,.empty-agenda button { display: inline-flex; align-items: center; gap: 8px; padding: 0; border: 0; background: none; color: #aaa6ff; font-size: 10px; font-weight: 600; }
.hero-decoration { position: absolute; top: 5px; right: 2%; width: 240px; height: 230px; display: grid; place-items: center; opacity: .75; }
.orbit { position: absolute; border: 1px solid #aaa5ff35; border-radius: 50%; transform: rotate(-28deg); }
.orbit-one { width: 205px; height: 95px; }
.orbit-two { width: 165px; height: 165px; border-color: #8a86ff25; }
.orbit-core { display: grid; place-items: center; width: 65px; height: 65px; border: 1px solid #a39fff88; border-radius: 20px; background: linear-gradient(145deg,#7774ed44,#272744); box-shadow: 0 0 45px #7774ed55; color: white; font: 800 27px Manrope,sans-serif; transform: rotate(-12deg); }
.orbit-core span { color: #9b98ff; }
.hero-number { position: absolute; right: 18px; bottom: 14px; color: #787b9a; font-size: 8px; letter-spacing: 1px; }
.together-card { display: flex; flex-direction: column; justify-content: space-between; padding: 20px 21px 15px; background: linear-gradient(145deg,#171b23,#142126); border-color: #283a3d; }
.together-top { display: flex; justify-content: space-between; align-items: center; }
.together-icon { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: #5caa9b20; color: #83c9b6; }
.live-label { display: flex; align-items: center; gap: 7px; color: #84b9aa; font-size: 8px; font-weight: 700; letter-spacing: .8px; }
.live-label span { width: 5px; height: 5px; }
.card-overline { color: #7caeaa; font-size: 8px; font-weight: 700; letter-spacing: 1px; }
.together-card h2 { margin: 7px 0 5px; color: #eaf3f1; font: 700 22px/1.25 Manrope,sans-serif; }
.together-card h2 span { color: #81c8b4; }
.together-card p { max-width: 260px; margin-bottom: 12px; color: #96a8a8; font-size: 10px; line-height: 1.5; }
.together-card > button { color: #8bc9b7; }
.couple-avatars { display: flex; align-items: center; margin-top: 13px; padding-top: 11px; border-top: 1px solid #304344; }
.couple-avatars div { display: grid; place-items: center; width: 23px; height: 23px; margin-right: -5px; border: 2px solid #172126; border-radius: 50%; background: #5553a0; color: white; font-size: 8px; font-weight: 700; }
.couple-avatars div:nth-child(2) { background: #b07883; }
.couple-avatars span { margin-left: 12px; color: #91a6a3; font-size: 9px; }

.stats-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 13px; margin-top: 17px; }
.stat-card { min-height: 116px; padding: 15px 16px; border: 1px solid #242938; border-radius: 10px; background: #11141c; }
.stat-top { display: flex; align-items: center; justify-content: space-between; color: #9299aa; font-size: 10px; }
.stat-top svg { color: #8581ed; }
.stat-card > strong { display: block; margin: 8px 0 4px; color: #f0f1f8; font: 700 24px Manrope,sans-serif; }
.stat-card > strong small { color: #777e91; font-size: 11px; font-weight: 500; }
.stat-foot { color: #737b8e; font-size: 9px; }
.progress-track { width: 100%; height: 3px; margin: 7px 0; overflow: hidden; border-radius: 4px; background: #292d3a; }
.progress-track div { height: 100%; border-radius: 4px; background: linear-gradient(90deg,#7774ed,#8cafff); transition: width .3s; }

.content-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 15px; margin-top: 18px; }
.panel { min-height: 235px; padding: 18px 19px 13px; border: 1px solid #252938; border-radius: 11px; background: #11141c; }
.panel-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 13px; }
.section-kicker { color: #7774ed; font-size: 8px; }
.panel-header h3,.bottom-heading h3 { margin: 5px 0 0; color: #e8eaf3; font: 650 15px Manrope,sans-serif; }
.text-button { display: flex; align-items: center; gap: 5px; border: 0; background: transparent; color: #9b97ff; font-size: 10px; }
.task-list { display: grid; }
.task-row { display: flex; align-items: center; gap: 10px; min-height: 42px; padding: 0 2px; border: 0; border-bottom: 1px solid #252938; background: transparent; text-align: left; }
.task-check { display: grid; place-items: center; flex-shrink: 0; width: 17px; height: 17px; border: 1px solid #454b60; border-radius: 5px; color: #80c7b4; }
.task-done .task-check { border-color: transparent; }
.task-title { flex: 1; color: #c6cad6; font-size: 10px; }
.task-done .task-title { color: #6e7586; text-decoration: line-through; }
.task-time { display: flex; align-items: center; gap: 5px; color: #737b8e; font-size: 9px; }
.panel-footer { display: flex; align-items: center; gap: 7px; margin-top: 13px; padding: 0; border: 0; background: transparent; color: #9290ed; font-size: 9px; }
.muted-icon { color: #7d8294; }
.empty-agenda { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 150px; text-align: center; }
.empty-icon { display: grid; place-items: center; width: 39px; height: 39px; margin-bottom: 10px; border: 1px solid #303449; border-radius: 11px; background: #1a1d2b; color: #8b87f1; }
.empty-agenda strong { color: #cbd0dd; font-size: 10px; }
.empty-agenda p { max-width: 275px; margin: 6px 0 11px; color: #7d8496; font-size: 9px; line-height: 1.6; }
.empty-agenda button { font-size: 9px; }
.empty-state { color: #858b9e; font-size: 10px; }

.bottom-section { margin-top: 24px; }
.bottom-heading { display: flex; justify-content: space-between; align-items: center; margin-bottom: 13px; }
.bottom-heading > svg { color: #8581ed; }
.bottom-heading h3 { font-size: 14px; }
.module-grid { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; }
.module-card { position: relative; display: flex; flex-direction: column; align-items: flex-start; min-height: 110px; padding: 13px; border: 1px solid #252938; border-radius: 10px; background: #11141c; text-align: left; transition: .2s; }
.module-card:hover { transform: translateY(-2px); border-color: #55528d; background: #151927; }
.module-icon { display: grid; place-items: center; width: 29px; height: 29px; margin-bottom: 10px; border-radius: 8px; background: #7774ed1d; color: #9b97ff; }
.module-card strong { color: #dfe2ed; font-size: 10px; }
.module-card > span { margin-top: 4px; color: #777f91; font-size: 8px; }
.module-arrow { position: absolute; top: 15px; right: 13px; color: #656c7e; }
.footer { display: flex; justify-content: space-between; margin-top: 26px; padding-top: 14px; border-top: 1px solid #222633; color: #9995ed; font: 800 10px Manrope,sans-serif; letter-spacing: 1px; }
.footer-muted { margin-left: 5px; color: #60677a; font: 600 8px 'DM Sans',sans-serif; }
.footer > span:last-child { color: #596174; font: 600 8px 'DM Sans',sans-serif; letter-spacing: 1px; }

@media (min-width: 1500px) {
  .dashboard { padding-top: 45px; }
  .hero-card,.together-card { min-height: 265px; }
}
@media (max-width: 1100px) {
  .dashboard { padding-right: 25px; padding-left: 25px; }
  .topbar { padding: 0 25px; }
  .hero-decoration { right: -50px; opacity: .45; }
  .module-grid { grid-template-columns: repeat(2,1fr); }
}
@media (max-width: 760px) {
  .sidebar-wrap { display: none; }
  .sidebar-wrap:has(.mobile-visible) { display: block; }
  .mobile-visible { position: fixed; inset: 0 auto 0 0; z-index: 40; width: 270px; }
  .mobile-visible .sidebar { box-shadow: 20px 0 60px #0009; }
  .mobile-overlay { display: block; position: fixed; inset: 0; z-index: 30; background: #0009; }
  .mobile-close,.mobile-menu { display: grid; place-items: center; border: 0; background: transparent; color: #b7bbca; }
  .mobile-close { margin-left: auto; }
  .main-area { margin-left: 0; }
  .topbar { height: 60px; padding: 0 17px; }
  .topbar-actions { gap: 10px; }
  .search-box { width: 145px; }
  .search-box kbd { display: none; }
  .dashboard { padding: 28px 17px 20px; }
  .welcome-section { align-items: flex-start; gap: 15px; }
  .welcome-section h1 { font-size: 26px; }
  .welcome-subtitle { max-width: 260px; font-size: 10px; }
  .primary-button { flex-shrink: 0; padding: 9px 10px; font-size: 9px; }
  .hero-grid { grid-template-columns: 1fr; }
  .hero-card { min-height: 225px; }
  .together-card { min-height: 220px; }
  .hero-decoration { right: -55px; opacity: .35; }
  .stats-grid { grid-template-columns: repeat(2,1fr); }
  .content-grid { grid-template-columns: 1fr; }
  .module-grid { grid-template-columns: repeat(2,1fr); }
  .footer > span:last-child { display: none; }
}
@media (max-width: 390px) {
  .search-box { width: 115px; }
  .breadcrumb { gap: 6px; }
  .welcome-section { flex-direction: column; }
  .primary-button { align-self: flex-start; }
  .hero-content { padding: 22px 19px; }
  .hero-content h2 { font-size: 21px; }
  .stat-card { padding: 12px; }
}

